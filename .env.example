# Escolha uma senha forte para bancos novos. Em volumes existentes, use as credenciais atuais.
DB_PASSWORD=
FRONTEND_HOST_PORT=4321
# Opcional: caminho do frontend relativo a esta pasta (padrao: ../Balaio-Front/Frontend).
# FRONTEND_CONTEXT=../Balaio-Front/Frontend
GATEWAY_HOST_PORT=8080
CATALOG_HOST_PORT=8081
PROFILE_HOST_PORT=8082
COMMERCE_HOST_PORT=8083
COMMUNITY_HOST_PORT=8084
EVENTS_HOST_PORT=8085

CATALOG_DB_NAME=balaio_catalog
CATALOG_DB_HOST_PORT=5433
CATALOG_DB_USERNAME=balaio_catalog_app

PROFILE_DB_HOST_PORT=5434
COMMERCE_DB_HOST_PORT=5435
COMMUNITY_DB_HOST_PORT=5436
EVENTS_DB_HOST_PORT=5437

# Copie para .env (ignorado pelo Git). Padroes locais; o provedor e selecionado por ambiente.
# Homologacao: substitua por uma URL HTTPS acessivel do frontend.
PROFILE_FRONTEND_BASE_URL=http://localhost:4321
PROFILE_RECOVERY_TOKEN_TTL=PT1H
PROFILE_SMTP_HOST=localhost
PROFILE_SMTP_PORT=1025
PROFILE_SMTP_USERNAME=
PROFILE_SMTP_PASSWORD=
PROFILE_SMTP_AUTH=false
PROFILE_SMTP_STARTTLS=false
# Timeouts em milissegundos; TLS e certificados permanecem validados.
PROFILE_SMTP_CONNECTION_TIMEOUT=5000
PROFILE_SMTP_READ_TIMEOUT=10000
PROFILE_SMTP_WRITE_TIMEOUT=10000
PROFILE_MAIL_FROM=nao-responda@localhost
# Gmail: substitua os valores acima (nao adicione variaveis duplicadas):
# PROFILE_SMTP_HOST=smtp.gmail.com
# PROFILE_SMTP_PORT=587
# PROFILE_SMTP_USERNAME=<conta Gmail autorizada>
# PROFILE_SMTP_PASSWORD=<senha de app; exige verificacao em duas etapas>
# PROFILE_SMTP_AUTH=true
# PROFILE_SMTP_STARTTLS=true
# PROFILE_MAIL_FROM=<remetente autorizado>
# PROFILE_FRONTEND_BASE_URL=https://<frontend acessivel da homologacao>
# Nunca use a senha normal da conta. SMTP local precisa de um servidor em execucao;
# localhost dentro do container e o proprio container. Consulte o README do Profile.

# O par JWT RSA e gerado pelo profile-service no volume do Compose.
JWT_ISSUER=balaio-local
JWT_AUDIENCE=balaio-api
BALAIO_INTERNAL_TOKEN=
AUTH_ALLOWED_ORIGINS=http://localhost:4321
# Somente para HTTP local. Em HTTPS/produção, defina true.
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
QA_ADMIN_SENHA=

# Mercado Pago: MERCADOPAGO_ENVIRONMENT=sandbox (credenciais de teste) ou production (credenciais reais).
# Exige token APP_USR-, segredo do webhook e URLs HTTPS publicas; nunca versionar valores reais.
MERCADOPAGO_ENVIRONMENT=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
FRONTEND_RETURN_URL=

# E-mails de pedido do commerce (PI-42). Local: SMTP sem autenticacao em localhost:1025.
COMMERCE_SMTP_HOST=localhost
COMMERCE_SMTP_PORT=1025
COMMERCE_SMTP_USERNAME=
COMMERCE_SMTP_PASSWORD=
COMMERCE_SMTP_AUTH=false
COMMERCE_SMTP_STARTTLS=false
COMMERCE_MAIL_FROM=nao-responda@localhost
COMMERCE_FRONTEND_BASE_URL=http://localhost:4321

# Frete Melhor Envio (PI-212). Sem token, o commerce usa a cotacao fixa demonstrativa.
# Sandbox: https://sandbox.melhorenvio.com.br (padrao). Producao: https://melhorenvio.com.br com o token da conta real.
# Token sandbox: veja commerce-service/docs/PI-263-melhor-envio-sandbox.md; nunca versionar o valor.
MELHORENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHORENVIO_TOKEN=
MELHORENVIO_CEP_ORIGEM=50030230
MELHORENVIO_USER_AGENT=Balaio homologacao

# Storage S3 externo das fotos (perfil e catalogo). Sem estes valores o envio de fotos responde 503.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=balaio-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
CATALOG_S3_ENABLED=false
CATALOG_S3_ENDPOINT=
CATALOG_S3_REGION=us-east-1
CATALOG_S3_BUCKET=balaio-media
CATALOG_S3_ACCESS_KEY_ID=
CATALOG_S3_SECRET_ACCESS_KEY=
