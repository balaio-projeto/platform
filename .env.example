# Escolha uma senha forte para bancos novos. Em volumes existentes, use as credenciais atuais.
DB_PASSWORD=
FRONTEND_HOST_PORT=4321
GATEWAY_HOST_PORT=8080
CATALOG_HOST_PORT=8081
PROFILE_HOST_PORT=8082
COMMERCE_HOST_PORT=8083
COMMUNITY_HOST_PORT=8084
EVENTS_HOST_PORT=8085

CATALOG_DB_NAME=balaio_catalog
CATALOG_DB_HOST_PORT=5433
CATALOG_DB_USERNAME=balaio_catalog_app

PROFILE_DB_HOST_PORT=5434
COMMERCE_DB_HOST_PORT=5435
COMMUNITY_DB_HOST_PORT=5436
EVENTS_DB_HOST_PORT=5437

# Copie para .env (ignorado pelo Git) e configure o SMTP do ambiente de validação.
PROFILE_FRONTEND_BASE_URL=https://frontend.exemplo.invalid
PROFILE_RECOVERY_TOKEN_TTL=PT1H
PROFILE_SMTP_HOST=smtp.exemplo.invalid
PROFILE_SMTP_PORT=587
PROFILE_SMTP_USERNAME=
PROFILE_SMTP_PASSWORD=
PROFILE_SMTP_AUTH=true
PROFILE_SMTP_STARTTLS=true
PROFILE_MAIL_FROM=nao-responda@exemplo.invalid

# Chaves RSA correspondentes; mantenha a privada fora do Git.
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
JWT_ISSUER=balaio-local
JWT_AUDIENCE=balaio-api
BALAIO_INTERNAL_TOKEN=
AUTH_ALLOWED_ORIGINS=http://localhost:4321
# Somente para HTTP local. Em HTTPS/produção, defina true.
AUTH_COOKIE_SECURE=false
