# O setup cria admin.env nesta pasta com apenas as duas variaveis abaixo, se faltar.
# Antes do primeiro docker compose up, preencha os valores no arquivo criado.
# secrets/admin.env e ignorado pelo Git e lido somente pelo profile-service.

# Email da conta administradora inicial.
ADMIN_EMAIL=

# Senha inicial escolhida por voce (minimo de 12 caracteres).
# Nao use aqui uma senha real: este arquivo de exemplo e versionado.
ADMIN_SENHA_INICIAL=

# O administrador e criado uma unica vez na inicializacao do banco.
# Depois disso, mudar estes valores nao altera a conta nem redefine a senha.
